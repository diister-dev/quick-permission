{
  "compilerOptions": {
    "target": "es2023",
    // `dom` is here for the web globals the code uses, which every target
    // runtime provides. It also keeps Deno in step: `deno publish` reads this
    // file, and without it the JSR type-check fails on those same globals.
    "lib": ["esnext", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["mod.ts", "core", "sift", "*.ts", "test", "scripts"]
}
